  mutate(lag_PM_TRIPS = st_lag(
    TRIPS, nb, wt
  ), .before = 1) %>%
  unnest(lag_PM_TRIPS)

write_rds(lisa_pm_lag, "data/rds/lisa_pm_lag.rds")
```

