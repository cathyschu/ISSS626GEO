hexagon_data_moranI_wkd <- hexagon_contiguity_ft %>%
  left_join(weekend_trips_hex %>% 
              select(HEX_ID, TRIPS), 
            by = "HEX_ID")
    
# Recreate nb and wt
hexagon_data_moranI_wkd <- hexagon_data_moranI_wkd %>%
