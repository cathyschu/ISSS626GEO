childcare_sf <- st_read("data/ChildCareServices.kml") %>%
st_zm(drop = TRUE, what = "ZM") %>%
st_transform(crs = 3414)
#| code-fold: true
#| code-summary: "Show code for ppp conversion"
#convert to ppp
childcare_ppp <- as.ppp(childcare_sf)
#create owin object
sg_owin <- as.owin(mpsz_cl)
#combien point events object and owin object
childcareSG_ppp = childcare_ppp[sg_owin]
#extract study areas
pg <- mpsz_cl %>%
filter(PLN_AREA_N == "PUNGGOL")
tm <- mpsz_cl %>%
filter(PLN_AREA_N == "TAMPINES")
ck <- mpsz_cl %>%
filter(PLN_AREA_N == "CHOA CHU KANG")
jw <- mpsz_cl %>%
filter(PLN_AREA_N == "JURONG WEST")
#| code-fold: true
#| code-summary: "Show code for plotting"
#| fig-width: 12
#| fig-height: 8
#create owin object
pg_owin = as.owin(pg)
tm_owin = as.owin(tm)
ck_owin = as.owin(ck)
jw_owin = as.owin(jw)
#combine point events object and owin object
childcare_pg_ppp = childcare_ppp[pg_owin]
childcare_tm_ppp = childcare_ppp[tm_owin]
childcare_ck_ppp = childcare_ppp[ck_owin]
childcare_jw_ppp = childcare_ppp[jw_owin]
#transform measurement to km
childcare_pg_ppp.km = rescale.ppp(childcare_pg_ppp, 1000, "km")
childcare_tm_ppp.km = rescale.ppp(childcare_tm_ppp, 1000, "km")
childcare_ck_ppp.km = rescale.ppp(childcare_ck_ppp, 1000, "km")
childcare_jw_ppp.km = rescale.ppp(childcare_jw_ppp, 1000, "km")
#plot
par(bg = "#e6f0e6", mfrow = c(2,2), mar = c(1, 1, 2, 1))
plot(unmark(childcare_pg_ppp.km), main = "Punggol")
plot(unmark(childcare_tm_ppp.km), main = "Tampines")
plot(unmark(childcare_ck_ppp.km), main = "Choa Chu Kang")
plot(unmark(childcare_jw_ppp.km), main = "Jurong West")
set.seed(1234)
par(bg = "#EEEEEE")
G_CK = Gest(childcare_ck_ppp, correction = "border")
plot(G_CK, xlim = c(0,500))
par(bg = "#EEEEEE")
G_CK.csr <- envelope(childcare_ck_ppp, Gest, nsim = 999)
par(bg = "#EEEEEE")
plot(G_CK.csr)
par(bg = "#EEEEEE")
G_TM = Gest(childcare_tm_ppp, correction = "best")
plot(G_TM)
G_TM.csr <- envelope(childcare_tm_ppp, Gest, correction = "all", nsim = 999)
par(bg = "#EEEEEE")
plot(G_TM.csr)
par(bg = "#EEEEEE")
F_CK = Fest(childcare_ck_ppp)
plot(F_CK)
F_CK.csr <- envelope(childcare_ck_ppp, Fest, nsim = 999)
par(bg = "#EEEEEE")
plot(F_CK.csr)
par(bg = "#EEEEEE")
F_TM = Fest(childcare_tm_ppp, correction = "best")
plot(F_TM)
F_TM.csr <- envelope(childcare_tm_ppp, Fest, correction = "all", nsim = 999)
par(bg = "#EEEEEE")
plot(F_TM.csr)
par(bg = "#EEEEEE")
plot(K_ck.csr, . - r ~ r, xlab="d", ylab="K(d)-r")
par(bg = "#EEEEEE")
K_ck.csr <- envelope(childcare_ck_ppp, Kest, nsim = 99, rank = 1, glocal=TRUE)
par(bg = "#EEEEEE")
plot(K_ck.csr, . - r ~ r, xlab="d", ylab="K(d)-r")
par(bg = "#EEEEEE")
K_TM = Kest(childcare_tm_ppp, correction = "Ripley")
plot(K_TM, . - r ~ r, ylab = "K(d)-r", xlab = "d(m)",
xlim = c(0, 1000))
par(bg = "#EEEEEE")
plot(K_TM.csr, . - r ~ r,
